## Docker
## ======

## the image is built from this repository by `docker compose up -d --build`
DELITESCO_IMAGE=delitesco-core
DELITESCO_VERSION=latest

## Postgres Database
## =================

POSTGRES_DB=delitesco

POSTGRES_USER=paste-user-here
## letters and digits only (it is used in URLs and in the Postfix config): openssl rand -hex 24
POSTGRES_PASSWORD=paste-password-here

## Postfix
## =======

## Obtain this key here: https://www.spamhaus.com/free-trial/sign-up-for-a-free-data-query-service-account/
## Why? https://check.spamhaus.org/returnc/pub
## Without it, Postfix queries the public Spamhaus zones, which refuse queries made through
## public DNS resolvers.
#SPAMHAUS_DQS_KEY=

## delitesco-core App
## ==================

## the API is served on https://$SUBDOMAIN.$DOMAIN
DOMAIN=paste-domain-here
SUBDOMAIN=app

## domain used to create aliases; may differ from DOMAIN (e.g. a separate alias domain)
EMAIL_DOMAIN=$DOMAIN

## name of the mail server: Postfix HELO and certificate, the MX of the alias domain and of
## custom domains. Needs an A record to this server and the server's PTR record set to it.
## Default: mail.$EMAIL_DOMAIN
#MAIL_HOSTNAME=mail.$EMAIL_DOMAIN

## URL of this server (HTTPS through Traefik)
URL=https://$SUBDOMAIN.$DOMAIN

## transactional email is sent from this email address
SUPPORT_EMAIL=support@$DOMAIN

## gets the daily abuse report and an alert when the replies of an account are blocked
ABUSE_REPORT_EMAIL=abuse@$DOMAIN

## Service emails (mailbox confirmation, alerts) come from this address. Default:
## noreply@$EMAIL_DOMAIN. A subdomain of your main domain keeps their reputation apart from
## the alias domain, and works even when that domain's mail is handled by another server:
## only a DKIM record is needed there (sl-init prints it); bounces stay on the alias domain.
#NOREPLY=noreply@notify.$DOMAIN

## By default, new aliases must end with ".{random_word}". This is to avoid a person taking all "nice" aliases.
## With many users on shared domains, keep the suffix: comment this out.
#DISABLE_ALIAS_SUFFIX=1

## selector the server signs with: dkim (default), dkim02 or dkim03; see "Replacing a DKIM key" in README.md
#DKIM_SELECTOR=dkim

## the DKIM private key used to compute DKIM-Signature: always /sl/dkim.key in the
## sl-data volume (set by docker-compose.yml). sl-init generates it on the first start;
## to keep an existing key, copy it there first (see README.md).

## DB Connection
DB_URI=postgresql://$POSTGRES_USER:$POSTGRES_PASSWORD@sl-db:5432/$POSTGRES_DB

## signs links and derives the other keys; at least 32 characters: openssl rand -hex 32
## (keep the existing value when migrating: changing it invalidates signed links)
FLASK_SECRET=paste-flask-secret-here

## PGP keys and refused / quarantined emails are stored in the sl-data volume
## (GNUPGHOME=/sl/pgp, UPLOAD_DIR=/sl/upload, set by docker-compose.yml)

## outgoing mail goes through Postfix on the mail-out network (set by docker-compose.yml)
#POSTFIX_SERVER=postfix-relay

## Redis: rate limits and locks are only enforced with it. docker-compose.yml builds
## MEM_STORE_URI from this password; letters and digits only: openssl rand -hex 32
REDIS_PASSWORD=paste-redis-password-here

## Frontend backend
## ================

## the backend in front of this service creates one user per account with this key
## (header X-Provisioning-Key); at least 32 characters: openssl rand -hex 32
PROVISIONING_API_KEY=paste-provisioning-key-here

## frontend page that confirms mailboxes (calls POST /api/mailboxes/<id>/verify)
MAILBOX_VERIFY_URL=https://$DOMAIN/account/forwarding/verify

## receives the signed mailto: actions (disable alias, block sender, unsubscribe)
UNSUBSCRIBER=unsubscribe@$DOMAIN

## name used in emails and notifications
BRAND_NAME=delitesco

## Who may call the API through Traefik (comma separated CIDRs): the frontend backend's
## address, e.g. 203.0.113.10/32. Required.
API_ALLOWED_IPS=paste-frontend-ip-here/32

## Who may call /api/provision/* (default: 10.79.0.0/24, the "delitesco-api" Docker network the
## frontend backend joins to call http://sl-app:7777 directly). Opening it to any address
## (0.0.0.0/0) is refused unless PROVISIONING_EMERGENCY_OPEN=true is also set; then every
## provisioning request logs an error. Emergency use only.
#PROVISIONING_ALLOWED_IPS=203.0.113.10/32
#PROVISIONING_EMERGENCY_OPEN=true

## Check the SPF of replies sent through reverse aliases against the client IP that Postfix
## records: a reply from an IP the mailbox domain does not allow is refused.
ENFORCE_SPF=true

## Traefik
## =======

## E-Mail used for Letsencrypt registration
LE_EMAIL=$SUPPORT_EMAIL

## Set requested ACME CHALLENGE to one of [ "tls", "dns" ]
## see https://letsencrypt.org/docs/challenge-types/
## 1) "tls" (-ALPN) is default and works out of the box - but cannot request wildcard certificates
## 2) "dns" can request wildcard certificates,
##    but needs additional configuration depending on your DNS registrar
LE_CHALLENGE=tls

## If you use LE_CHALLENGE=dns, you have to define your DNS provider here
## see https://go-acme.github.io/lego/dns/ which "Code" identifies your provider
# LE_DNS_PROVIDER=cloudflare

## The DNS provider credentials (CF_DNS_API_TOKEN etc.) go in traefik.env, not here:
## see traefik.env.example. Traefik does not receive this file.
